<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Uprawnienia wymagane -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth (Android 11 i wcześniejsze) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Bluetooth (Android 12+). neverForLocation: ten skan czyta tylko adres/nazwę/RSSI,
         nigdy nie wyprowadza z niego pozycji użytkownika - dzięki tej deklaracji Android
         12+ nie wymaga do NIEGO włączonej systemowej Lokalizacji (inne funkcje appki,
         np. pogoda, nadal proszą o ACCESS_FINE_LOCATION osobno, patrz niżej). Bez tej flagi
         skan potrafi po cichu nie zwracać żadnych wyników, gdy użytkownik ma wyłączoną
         Lokalizację w ustawieniach systemu, mimo przyznanych uprawnień Bluetooth. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Wi-Fi Direct - transfer wideo i plików w pełnej rozdzielczości z okularów -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Android 13+: zastępuje lokalizację przy wykrywaniu urządzeń Wi-Fi.
         neverForLocation - nie wyprowadzamy z tego pozycji użytkownika. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- Mikrofon (V.I.C.T.O.R.) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Kamera (jeśli używamy kamery telefonu jako fallback) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Akcje bezpośrednie (tryb "szybki" - z dialogiem potwierdzenia) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Proaktywne alerty (pogoda + kalendarz) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lokalizacja: skanowanie BLE (Android 6-11), Wi-Fi Direct (poniżej 13),
         pogoda i alerty proaktywne. Jedna deklaracja - duplikat wywala
         scalanie manifestu. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- WorkManager (dla ProactiveAlertsWorker) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Usługa pierwszoplanowa - trzyma połączenie BLE i nasłuch wake worda
         przy życiu, gdy ekran jest zgaszony (inaczej Doze zabija oba po kilku
         minutach). Typowane uprawnienia wymagane od Androida 14. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Pobieranie modelu lokalnego (~560MB) w tle - patrz LocalModelDownloadService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Wyjątek Doze/App Standby - patrz pl.victor.app.power.BatteryOptimizationHelper. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Bez tego ustawianie budzika kończy się odmową uprawnienia - a tak właśnie
      było: AI poprawnie rozpoznawało prośbę i zlecało akcję, po czym
      AlarmClock.ACTION_SET_ALARM odbijał się o brak uprawnienia. Nie jest to
      uprawnienie "niebezpieczne" - wystarczy zadeklarować, nie trzeba o nie
      pytać w czasie działania. Ta sama sprawa dotyczy timera.
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Storage (dla cache zdjęć i historii) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Wymagane features -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <!-- Queries (Android 11+) - widoczność innych apek dla Intentów -->
    <queries>
        <!-- SMS, dialer, email -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- Spotify, YouTube, Maps, itd. -->
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <!-- Przeglądarka -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <!-- Media controls -->
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <!-- Alarm / timer -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <!-- Kalendarz: formularz nowego wydarzenia -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- Mapy: dowolna aplikacja obsługująca geo:, nie tylko Google -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- Translation (Android 12+) -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".VictorApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Victor"
        tools:targetApi="33"
        tools:replace="android:allowBackup">
        <!-- tools:replace wymagane, bo vendor SDK (glasses_sdk AAR) deklaruje
             allowBackup="true". Aplikacja trzyma zaszyfrowane klucze API,
             więc kopia zapasowa musi zostać wyłączona. -->

        <!-- Google Sign-In (Calendar API) - wymaga OAuth client w dev/prod -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Victor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="Ustawienia" />

        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false"
            android:label="Historia" />

        <activity
            android:name=".ui.notes.NotesActivity"
            android:exported="false"
            android:label="Notatki" />
        <activity
            android:name=".ui.memory.FactsActivity"
            android:exported="false"
            android:label="Co o Tobie wiem" />

        <activity
            android:name=".ui.media.MediaActivity"
            android:exported="false"
            android:label="Galeria okularów" />

        <activity
            android:name=".ui.livepreview.LivePreviewActivity"
            android:exported="false"
            android:label="Podgląd na żywo" />

        <activity
            android:name=".ui.commands.CommandsActivity"
            android:exported="false"
            android:label="Komendy" />

        <activity
            android:name=".ui.pairing.PairingActivity"
            android:exported="false"
            android:label="Połącz z okularami" />

        <activity
            android:name=".ui.diagnostics.DiagnosticsActivity"
            android:exported="false"
            android:label="Diagnostyka okularów" />

        <!-- Ukryty ekran - dostęp wyłącznie przez świadomy gest (stuknięcie
             numeru wersji w Ustawieniach), patrz DeveloperOptionsGate. -->
        <activity
            android:name=".ui.developer.DeveloperOptionsActivity"
            android:exported="false"
            android:label="Opcje programistyczne" />

        <activity
            android:name=".vision.QRTestActivity"
            android:exported="false"
            android:label="Test skanera QR" />

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:label="Konfiguracja V.I.C.T.O.R."
            android:theme="@style/Theme.Victor" />

        <service
            android:name=".ble.VictorForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <service
            android:name=".localmodel.LocalModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Eksport logów Live Stream Lab (Opcje programistyczne) przez Android
             share sheet - udostępnia wyłącznie filesDir/livestream_lab/. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
